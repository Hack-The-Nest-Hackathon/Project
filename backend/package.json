{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc && node database/copy-sql.mjs",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "db:init": "tsx --env-file-if-exists=.env database/init.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {"fastify": "^5.8.0", "@fastify/rate-limit": "^10.3.0", "@types/pg": "^8.15.0", "pg": "^8.16.0"},
  "devDependencies": {"@types/node": "^22.0.0", "tsx": "^4.20.0", "typescript": "^5.9.0"}
}

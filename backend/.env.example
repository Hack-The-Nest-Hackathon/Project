PORT=3001
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/field_notes
HOST=127.0.0.1
ELEVENLABS_API_KEYS=[]
# Optional narrator voice for quiz audio.
ELEVENLABS_VOICE_ID=
# Optional overrides. Keys: Merchant, Baker, Quartermaster, Lamplighter, Scout,
# Gatekeeper, station-0, station-1, station-2, player.
ELEVENLABS_CHARACTER_VOICES={}
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_CONCURRENCY=1



# SSOJet regular web application. Copy the issuer from the dashboard.
# SSOJET_AUTHORITY is also accepted for existing configurations.
SSOJET_ISSUER=
SSOJET_CLIENT_ID=
SSOJET_CLIENT_SECRET=
SSOJET_TOKEN_AUTH_METHOD=client_secret_post
SSOJET_PUBLIC_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
